; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Star Skirmish"
config/version="0.9.0"
config/description="Newtonian space combat. Join Azure squadron in a three-on-three asteroid-field skirmish."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameInput="*res://scripts/game_input.gd"
GameConfig="*res://scripts/game_config.gd"
GameSettings="*res://scripts/game_settings.gd"
Sfx="*res://scripts/sfx.gd"
GameMatch="*res://scripts/game_match.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=800
window/size/min_height=450
window/stretch/mode="canvas_items"

[physics]

3d/default_gravity=0.0

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
